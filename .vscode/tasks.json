{
    // Requires JAVA_HOME and ANDROID_HOME to be set (see README).
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Install & launch (debug)",
            "type": "shell",
            "command": "./gradlew installDebug && \"${env:ANDROID_HOME}/platform-tools/adb\" shell am start -n app.jpcard.reader/.MainActivity",
            "windows": {
                "command": ".\\gradlew.bat installDebug; if ($?) { & \"${env:ANDROID_HOME}\\platform-tools\\adb.exe\" shell am start -n app.jpcard.reader/.MainActivity }"
            },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": []
        },
        {
            "label": "Build release APK",
            "type": "shell",
            "command": "./gradlew assembleRelease",
            "windows": { "command": ".\\gradlew.bat assembleRelease" },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Install release",
            "type": "shell",
            "command": "./gradlew installRelease",
            "windows": { "command": ".\\gradlew.bat installRelease" },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Show crash log",
            "type": "shell",
            "command": "\"${env:ANDROID_HOME}/platform-tools/adb\" logcat -v brief AndroidRuntime:E *:S",
            "windows": { "command": "& \"${env:ANDROID_HOME}\\platform-tools\\adb.exe\" logcat -v brief AndroidRuntime:E *:S" },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Stop Gradle daemon",
            "detail": "Fixes 'classes.dex is being used by another process' on Windows",
            "type": "shell",
            "command": "./gradlew --stop",
            "windows": { "command": ".\\gradlew.bat --stop" },
            "problemMatcher": []
        }
    ]
}
