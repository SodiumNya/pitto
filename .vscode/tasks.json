{
    "version": "2.0.0",
    "options": {
        "env": {
            "JAVA_HOME": "C:\\Program Files\\Java\\jdk-17",
            "ANDROID_HOME": "F:\\dev\\android-sdk",
            "ANDROID_USER_HOME": "F:\\dev\\android-user",
            "GRADLE_USER_HOME": "F:\\dev\\gradle-home"
        }
    },
    "tasks": [
        {
            "label": "安装到手机并启动 (Debug)",
            "type": "shell",
            "command": ".\\gradlew.bat installDebug; if ($?) { F:\\dev\\android-sdk\\platform-tools\\adb.exe shell am start -n app.jpcard.reader/.MainActivity }",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": []
        },
        {
            "label": "构建 Debug APK",
            "type": "shell",
            "command": ".\\gradlew.bat assembleDebug",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "构建 Release APK（小体积）",
            "type": "shell",
            "command": ".\\gradlew.bat assembleRelease; if ($?) { explorer app\\build\\outputs\\apk\\release }",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "安装 Release 到手机",
            "type": "shell",
            "command": ".\\gradlew.bat installRelease",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "查看已连接设备",
            "type": "shell",
            "command": "F:\\dev\\android-sdk\\platform-tools\\adb.exe devices -l",
            "problemMatcher": []
        },
        {
            "label": "查看崩溃日志",
            "type": "shell",
            "command": "F:\\dev\\android-sdk\\platform-tools\\adb.exe logcat -v brief AndroidRuntime:E app.jpcard.reader:V *:S",
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "清理构建",
            "type": "shell",
            "command": ".\\gradlew.bat clean",
            "problemMatcher": []
        }
    ]
}
