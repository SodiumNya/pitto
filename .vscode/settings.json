{
    // 已装的 Java 插件会尝试把 Android 工程当普通 Gradle 工程导入并报错，这里关掉
    "java.import.gradle.enabled": false,
    "gradle.autoDetect": "off",
    "files.exclude": {
        "**/.gradle": true,
        "**/.kotlin": true,
        "**/build": true
    },
    "files.encoding": "utf8",
    "terminal.integrated.env.windows": {
        "JAVA_HOME": "C:\\Program Files\\Java\\jdk-17",
        "ANDROID_HOME": "F:\\dev\\android-sdk",
        "ANDROID_USER_HOME": "F:\\dev\\android-user",
        "GRADLE_USER_HOME": "F:\\dev\\gradle-home"
    }
}
